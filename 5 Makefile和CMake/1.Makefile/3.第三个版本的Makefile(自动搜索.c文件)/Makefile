# 表示单行注释,跟C语言不一样
# 具体规则语句，前面必须使用tab键缩进，不能使用空格
# 目标和依赖都写死了，每个程序员要编译的代码，使用的编译器都不一样
# 使用变量存放目标，存放依赖，存放编译器，存放编译选项
# 变量名=值   变量没有数据类型，直接定义就可以使用
# 获取变量的值   $(变量名字)

#定义变量表示目标，变量习惯性大写
TARGET=main
#定义变量表示依赖
#一个个文件名罗列，比较麻烦
#SRC=main.c wifi.c ble.c
#自动搜索匹配当前路径下任意.c
SRC=$(wildcard *.c)
#定义变量表示编译器
CC=gcc

$(TARGET):$(SRC)
	$(CC) $(SRC) -o $(TARGET)
	./$(TARGET)